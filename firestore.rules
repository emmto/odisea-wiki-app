rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir a usuarios autenticados leer y modificar su propio documento de perfil
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Permitir acceso a usuarios autenticados para colecciones de la app
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
